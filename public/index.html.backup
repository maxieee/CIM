/* ============================================================
   USER LOGIN
   ============================================================ */
$('user-login-form').addEventListener('submit', async (e)=>{
  e.preventDefault();
  const name = $('u-name').value.trim();
  const email = $('u-email').value.trim();
  const errEl = $('u-login-error');
  errEl.textContent = '';
  if(!name || !email){ errEl.textContent = 'Please enter both your name and email.'; return; }
  const emailOk = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
  if(!emailOk){ errEl.textContent = 'That email address doesn\'t look right.'; return; }

  currentUser = { name, email };
  const visitorRecord = {
    id: Date.now() + '-' + Math.random().toString(36).slice(2,7),
    name, email, time: new Date().toISOString()
  };

  // GATEWAY: hosted deployments write the login to the central database first.
  // The visitor is only allowed through when the central write succeeds.
  try{
    const remoteSaved = await apiLog('visitors', visitorRecord);
    if(!remoteSaved && location.protocol !== 'file:'){
      throw new Error('Visitor log gateway unavailable');
    }
  }catch(err){
    if(location.protocol === 'file:'){
      const visitors = await loadList('visitors');
      visitors.push(visitorRecord);
      await saveList('visitors', visitors);
    }else{
      currentUser = null;
      errEl.textContent = 'Unable to record your visit. Please try again.';
      return;
    }
  }

  // Populate all visitor-facing identity fields before opening the project selector.
  const dashName = $('dash-who-name');
  const dashNameP2 = $('dash-who-name-p2');
  const overviewName = $('ov-who-name');
  if(dashName) dashName.textContent = name;
  if(dashNameP2) dashNameP2.textContent = name;
  if(overviewName) overviewName.textContent = name;

  // Ensure the overview is actually displayed after a downloaded HTML file
  // is opened directly (file://), where external navigation assumptions can fail.
  await loadDashboardContent();
  show('view-overview');
  window.scrollTo({top:0, behavior:'instant'});
});

/* ============================================================
   ADMIN LOGIN
   ============================================================ */
$('admin-login-form').addEventListener('submit', async (e)=>{
  e.preventDefault();
  const user = $('a-user').value.trim();
  const pass = $('a-pass').value.trim();
  const errEl = $('a-login-error');
  errEl.textContent = '';
  try{
    // Live deployment: authenticate against the Netlify function.
    const auth = await fetch('/api/auth',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({user,pass})});
    if(auth.ok){
      const data = await auth.json();
      ADMIN_TOKEN=data.token;
      sessionStorage.setItem('casefile_admin_token',ADMIN_TOKEN);
      $('a-user').value=''; $('a-pass').value='';
      await enterAdmin();
      return;
    }
    // Standalone downloaded HTML: allow local testing without /api/auth.
    if(user === 'Ads123' && pass === '123123123'){
      ADMIN_TOKEN='local-admin';
      sessionStorage.setItem('casefile_admin_token',ADMIN_TOKEN);
      $('a-user').value=''; $('a-pass').value='';
      await enterAdmin();
      return;
    }
    throw new Error('bad credentials');
  }catch(e){
    // If the local file is opened via file://, fetch('/api/auth') can fail.
    if(user === 'Ads123' && pass === '123123123'){
      ADMIN_TOKEN='local-admin';
      sessionStorage.setItem('casefile_admin_token',ADMIN_TOKEN);
      $('a-user').value=''; $('a-pass').value='';
      await enterAdmin();
    }else{
      errEl.textContent = 'Incorrect User ID or password.';
    }
  }
});

/* ============================================================
   LOGOUT + FEEDBACK
   ============================================================ */
function openFeedbackModal(){
  pendingStar = 0;
  renderStars();
  $('feedback-text').value = '';
  $('feedback-modal').classList.remove('hidden');
}
$('btn-logout').addEventListener('click', openFeedbackModal);
$('btn-logout-p2').addEventListener('click', openFeedbackModal);

function renderStars(){
  document.querySelectorAll('.star-btn').forEach(b=>{
    b.classList.toggle('filled', parseInt(b.dataset.star,10) <= pendingStar);
  });
}
document.getElementById('star-row').addEventListener('click', (e)=>{
  const b = e.target.closest('.star-btn');
  if(!b) return;
  pendingStar = parseInt(b.dataset.star,10);
  renderStars();
});

async function finishLogout(withFeedback){
  if(withFeedback){
    const text = $('feedback-text').value.trim();
    const feedbacks = await loadList('feedbacks');
    const feedbackRecord = {
      id: Date.now() + '-' + Math.random().toString(36).slice(2,7),
      name: currentUser ? currentUser.name : 'Unknown',
      email: currentUser ? currentUser.email : 'unknown',
      rating: pendingStar,
      text: text,
      time: new Date().toISOString()
    };
    // GATEWAY: feedback is sent to the same central database before logout.
    const remoteSaved = await apiLog('feedbacks', feedbackRecord);
    if(!remoteSaved && location.protocol !== 'file:'){
      toast('Feedback could not be recorded. Please try again.');
      return;
    }
    if(location.protocol === 'file:'){
      const feedbacks = await loadList('feedbacks');
      feedbacks.push(feedbackRecord);
      await saveList('feedbacks', feedbacks);
    }
  }
  $('feedback-modal').classList.add('hidden');
  currentUser = null;
  $('u-name').value=''; $('u-email').value='';
  show('view-gate');
}
$('btn-submit-feedback').addEventListener('click', ()=> finishLogout(true));
$('btn-skip-feedback').addEventListener('click', ()=> finishLogout(false));

$('btn-admin-logout').addEventListener('click', ()=>{
  // Cleanly terminate the admin session. The old handler called an
  // undefined stopExcelAutoRefresh() function, which prevented logout.
  ADMIN_TOKEN = '';
  try{ sessionStorage.removeItem('casefile_admin_token'); }catch(e){}
  show('view-gate');
});

/* ============================================================
   DASHBOARD CONTENT (fully editable) — every element carrying a
   data-ck="key" attribute is discovered automatically. Its original
   text (as written in the HTML) is captured as the default; admin
   edits are stored as {key: text} and applied on top of that.
   ============================================================ */
const CK_DEFAULTS = {}; // key -> original text, captured once at startup
let CK_CURRENT = {};    // key -> active text (default, overridden by saved content)

function prepareVisitorInterfaceEditing(){
  /*
     Project One already uses explicit data-ck fields. To make the editor cover
     the complete visitor-facing interface (including Project Two, tabs, buttons,
     selector screens and mixed text blocks), wrap any remaining visible text
     nodes in stable data-ck spans before defaults are captured.
  */
  const roots = [
    ['view-gate','gateUI'],
    ['view-user-login','loginUI'],
    ['view-overview','overviewUI'],
    ['view-dashboard','dashboardUI'],
    ['view-dashboard-p2','p2'],
    ['feedback-modal','feedbackUI']
  ];
  roots.forEach(([rootId,prefix])=>{
    const root = document.getElementById(rootId);
    if(!root) return;
    let counter = 0;
    const walk = (el)=>{
      if(el.hasAttribute && el.hasAttribute('data-ck')) return;
      Array.from(el.childNodes).forEach(node=>{
        if(node.nodeType === Node.TEXT_NODE){
          const text = node.textContent.trim();
          if(!text || !/[A-Za-z0-9₹%]/.test(text)) return;
          const span = document.createElement('span');
          span.setAttribute('data-ck', prefix + '.auto.' + (++counter));
          span.textContent = node.textContent;
          node.parentNode.replaceChild(span,node);
        }else if(node.nodeType === Node.ELEMENT_NODE){
          walk(node);
        }
      });
    };
    walk(root);
  });
}
function captureDefaults(){
  prepareVisitorInterfaceEditing();
  document.querySelectorAll('[data-ck]').forEach(el=>{
    const key = el.getAttribute('data-ck');
    if(!(key in CK_DEFAULTS)) CK_DEFAULTS[key] = el.textContent.trim();
  });
}

function applyContent(content){
  CK_CURRENT = Object.assign({}, CK_DEFAULTS, content || {});
  document.querySelectorAll('[data-ck]').forEach(el=>{
    const key = el.getAttribute('data-ck');
    if(CK_CURRENT[key] != null) el.textContent = CK_CURRENT[key];
  });
}

async function loadDashboardContent(){
  let content = {};
  try{ const remote=await apiContentGet(); content=remote.content||{}; }catch(e){ const raw=await storageGet('dashboard-content-v2',true); if(raw){try{content=JSON.parse(raw)}catch(_){}} }
  applyContent(content); return content;
}

function buildEditorUI(){
  const host = $('editor-groups');
  host.innerHTML = '';
  const groups = {};
  Object.keys(CK_DEFAULTS).forEach(key=>{
    const prefix = key.split('.')[0];
    if(!groups[prefix]) groups[prefix] = [];
    groups[prefix].push(key);
  });
  Object.keys(CK_GROUPS).forEach(prefix=>{
    const keys = groups[prefix];
    if(!keys || keys.length === 0) return;
    const details = document.createElement('details');
    details.className = 'editor-group';
    const summary = document.createElement('summary');
    summary.textContent = CK_GROUPS[prefix] + ' (' + keys.length + ' fields)';
    details.appendChild(summary);
    const body = document.createElement('div');
    body.className = 'editor-group-body';
    keys.forEach(key=>{
      const field = document.createElement('div');
      field.className = 'editor-field';
      const label = document.createElement('label');
      label.textContent = key;
      const value = CK_CURRENT[key] != null ? CK_CURRENT[key] : CK_DEFAULTS[key];
      const long = value.length > 70;
      const input = document.createElement(long ? 'textarea' : 'input');
      if(!long) input.type = 'text';
      input.value = value;
      input.dataset.ckInput = key;
      field.appendChild(label);
      field.appendChild(input);
      body.appendChild(field);
    });
    details.appendChild(body);
    host.appendChild(details);
  });
}

$('btn-save-content').addEventListener('click', async ()=>{
  const content = {};
  document.querySelectorAll('[data-ck-input]').forEach(input=>{
    const key = input.dataset.ckInput;
    const val = input.value.trim();
    content[key] = val || CK_DEFAULTS[key];
  });
  await storageSet('dashboard-content-v2', JSON.stringify(content), true);
  try{ await apiContentSet(content); }catch(e){ console.warn('Remote content save failed; local copy retained.',e); }
  applyContent(content);
  const msg = $('save-msg');
  msg.classList.add('show');
  setTimeout(()=>msg.classList.remove('show'), 2500);
  toast('Dashboard content updated — live for every viewer.');
});

$('btn-reset-content').addEventListener('click', async ()=>{
  if(!confirm('Reset every field on the dashboard back to its original text? This cannot be undone.')) return;
  await storageSet('dashboard-content-v2', JSON.stringify({}), true);
  applyContent({});
  buildEditorUI();
  toast('Dashboard reset to original text.');
});

