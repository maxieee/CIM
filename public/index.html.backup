$('btn-select-p2').addEventListener('click', ()=> show('view-dashboard-p2'));
$('btn-projects-p1').addEventListener('click', ()=> show('view-overview'));
$('btn-projects-p2').addEventListener('click', ()=> show('view-overview'));
