<script>
/* ============================================================
   DATA
   ============================================================ */
const REPORT_PDF_BASE64 = "";

const CK_GROUPS = {
  overview: 'Overview',
  phase1: 'Phase 1 · Bengaluru',
  phase2: 'Phase 2 · Pan-India',
  astra: 'Astra & Findings',
  incentive: 'Incentive Plan',
  roadmap: 'Automation Roadmap',
  report: 'Download Report',
  footer: 'Footer',
  p2: 'Project Two · Entire Visitor Interface',
  overviewUI: 'Project Selector · Visitor Interface',
  gateUI: 'Entry Screen · Visitor Interface',
  loginUI: 'Visitor Login · Visitor Interface',
  feedbackUI: 'Feedback · Visitor Interface',
  dashboardUI: 'Project One · Remaining Visitor Interface'
};

const BENGALURU_DATA = {
  labels: ["New Pickup & Inward Requests", "Retrieval & Secure Destruction"],
  values: [600, 800]
};

const PAN_INDIA_DATA = [
  { location: "Bhubaneswar", emails: 15, newReq: 5, followUp: 1 },
  { location: "Chennai", emails: 90, newReq: 1, followUp: 7 },
  { location: "Ahmedabad", emails: 70, newReq: 0, followUp: 2 },
  { location: "Coimbatore", emails: 20, newReq: 0, followUp: 0 },
  { location: "Ludhiana", emails: 10, newReq: 2, followUp: 10 },
  { location: "Delhi", emails: 120, newReq: 3, followUp: 10 },
  { location: "Chandigarh", emails: 25, newReq: 1.5, followUp: 9 },
  { location: "Kolkata", emails: 120, newReq: 5, followUp: 1 },
  { location: "Hyderabad", emails: 9.5, newReq: 1.5, followUp: 1.5 },
  { location: "Indore", emails: 4.5, newReq: 1, followUp: 0 },
  { location: "Mumbai", emails: 250, newReq: 3.5, followUp: 50 },
  { location: "Pune", emails: 65, newReq: 12.5, followUp: 7.5 }
];

const ASTRA_DATA = {
  labels: ["Malaysia", "Philippines"],
  values: [90, 50],
  notes: ["90% client migration to Astra", "50% of email-based clients migrated"]
};

/* --- Project Two data (Strategic Prospect Analysis, 38 evaluated prospects) --- */
const INDUSTRY_DATA = [
  { label: "Banking & Financial Services", value: 12 },
  { label: "Manufacturing – Food, Beverage & Tobacco", value: 6 },
  { label: "Hospital & Health Services", value: 3 },
  { label: "Computer Hardware & Network Infra.", value: 3 },
  { label: "Manufacturing – Consumer Goods", value: 2 },
  { label: "Aerospace", value: 2 },
  { label: "Advertising & Market Research", value: 2 },
  { label: "Art, Entertainment & Mass Media", value: 2 },
  { label: "Logistics, Warehousing & Freight", value: 2 },
  { label: "Others (Heavy Industry, IT, Pharma, Education)", value: 4 }
];

const TECH_ADOPTION_DATA = [
  { label: "ERP Adoption", value: 81.6 },
  { label: "DMS Adoption", value: 78.9 },
  { label: "CRM Adoption", value: 13.2 }
];

const SERVICES_DATA = [
  { label: "EffiDocs Pro", value: 21 },
  { label: "FAMS", value: 20 },
  { label: "Escrow", value: 20 },
  { label: "DART", value: 18 },
  { label: "Visio", value: 17 },
  { label: "EffiDocs Plus", value: 14 },
  { label: "EffiDocs Lite", value: 2 }
];

/* ============================================================
   STATE
   ============================================================ */
let currentUser = null; // {name, email}
let pendingStar = 0;

/* ============================================================
   HELPERS
   ============================================================ */
function $(id){ return document.getElementById(id); }
function show(id){
  const target = document.getElementById(id);
  if(!target){
    console.error('Dashboard navigation target not found:', id);
    return false;
  }

  document.querySelectorAll('.screen').forEach(s => s.classList.add('hidden'));
  target.classList.remove('hidden');

  // Reset page position whenever the user enters a new interface.
  try{ window.scrollTo(0,0); }catch(e){}

  return true;
}

/* ============================================================
   EXCEL INTEGRATION — fill these in once, see setup steps below
   ============================================================
   1) EXCEL_FILE_LINK — the normal "Share" link (already filled in from what
      you sent). Used for the "Open in Excel" button.
   2) EXCEL_EMBED_URL — a DIFFERENT link from the same file: in OneDrive,
      open the file → File (or the "..." menu) → Share → Embed → Generate.
      Copy the URL inside the src="..." of the <iframe> it gives you (NOT
      the whole <iframe> tag, just that URL) and paste it below. This is
      what lets the admin console show the live spreadsheet.
   3) VISITOR_WEBHOOK_URL / FEEDBACK_WEBHOOK_URL — a plain share link cannot
      be written to from a webpage (it's a viewer link, not an API, and
      embedding real write credentials in a page anyone can view-source
      would let any visitor edit or wipe your sheet). The safe, supported
      bridge is a Microsoft Power Automate flow: trigger "When an HTTP
      request is received", action "Add a row into a table" (Excel Online
      (Business)) pointed at a table in this file. Power Automate gives you
      a URL for the trigger — paste it below. Until these two are filled
      in, sign-ins and feedback are simply kept in this artifact's own
      storage as a safety net, and nothing is lost.
   ============================================================ */
const EXCEL_FILE_LINK = 'https://1drv.ms/x/c/ecee0328163a1f18/IQC8lNbnR4ajRIE2WMYF_kpCAe9fk2dR87viYX6gMWEykZg?e=c890Z3';
const EXCEL_EMBED_URL = 'https://kumaragurudtsteam-my.sharepoint.com/personal/adarshsai_25mba_kct_ac_in/_layouts/15/Doc.aspx?sourcedoc={d752ea89-5257-4b06-a016-1c86e9505dbc}&action=embedview&wdAllowInteractivity=False&wdHideGridlines=True&wdHideHeaders=True&wdDownloadButton=True&wdInConfigurator=True&wdInConfigurator=True'; // paste the OneDrive "Embed" src URL here
const VISITOR_WEBHOOK_URL = 'https://default6b8b8296bdff4ad893ad84bcbf3842.f5.environment.api.powerplatform.com:443/powerautomate/automations/direct/cu/16/workflows/51b4015518ea4c1ebf3c4603d9b2aa2f/triggers/manual/paths/invoke?api-version=1'; // paste your Power Automate HTTP trigger URL (visitor sign-ins) here
const FEEDBACK_WEBHOOK_URL = 'https://default6b8b8296bdff4ad893ad84bcbf3842.f5.environment.api.powerplatform.com:443/powerautomate/automations/direct/cu/06/workflows/cd0a7d19b1a94b3cba8a161c704d3a83/triggers/manual/paths/invoke?api-version=1'; // paste your Power Automate HTTP trigger URL (feedback) here

/* Fire-and-forget POST to a webhook (e.g. a Power Automate flow). Uses
   'no-cors' because most webhook endpoints, Power Automate included, don't
   send back CORS headers a browser would need to read the response — this
   still delivers the request, we just can't (and don't need to) read what
   comes back. Silently does nothing if the URL hasn't been configured yet. */
async function sendToWebhook(url, payload){
  if(!url) return;
  try{
    await fetch(url, { method:'POST', mode:'no-cors', body: JSON.stringify(payload) });
  }catch(e){
    console.warn('Webhook call failed (data is still safe in the backup log):', e);
  }
}

/* Storage bridge: uses window.storage (shared, cross-visitor) when this file is
   rendered inside a Claude.ai artifact viewer. When opened as a plain downloaded
   HTML file (or wherever window.storage isn't available), falls back to this
   browser's localStorage so the dashboard still works end-to-end on one device. */
const API_BASE = '/api';
let ADMIN_TOKEN = sessionStorage.getItem('casefile_admin_token') || '';
async function apiRequest(path, options={}){
  const headers = Object.assign({'Content-Type':'application/json'}, options.headers||{});
  if(ADMIN_TOKEN) headers['x-admin-token']=ADMIN_TOKEN;
  const res = await fetch(API_BASE + path, Object.assign({}, options, {headers}));
  if(!res.ok) throw new Error(await res.text());
  return res.json();
}
async function apiLog(type, record){ try{ await apiRequest('/data', {method:'POST', body:JSON.stringify({type, record})}); return true; }catch(e){ console.warn('Remote log failed; local backup retained.',e); return false; } }
async function apiList(type){ return apiRequest('/data?type='+encodeURIComponent(type)); }
async function apiDelete(type,id){ return apiRequest('/data', {method:'DELETE', body:JSON.stringify({type,id})}); }
async function apiContentGet(){ return apiRequest('/content'); }
async function apiContentSet(content){ return apiRequest('/content',{method:'POST',body:JSON.stringify({content})}); }

const STORAGE_MODE = (typeof window.storage !== 'undefined' && window.storage && typeof window.storage.get === 'function') ? 'shared' : 'local';
const LOCAL_PREFIX = 'casefile_';

async function storageGet(key, shared){
  if(STORAGE_MODE === 'shared'){
    try{
      const res = await window.storage.get(key, shared);
      return res ? res.value : null;
    }catch(e){ /* fall through to local as a safety net */ }
  }
  try{ return window.localStorage.getItem(LOCAL_PREFIX + key); }catch(e){ return null; }
}
async function storageSet(key, value, shared){
  if(STORAGE_MODE === 'shared'){
    try{ await window.storage.set(key, value, shared); return true; }catch(e){ /* fall through */ }
  }
  try{ window.localStorage.setItem(LOCAL_PREFIX + key, value); return true; }catch(e){ console.error('storage set failed', e); return false; }
}


async function loadList(key){
  const raw = await storageGet(key, true);
  if(!raw) return [];
  try{ return JSON.parse(raw); }catch(e){ return []; }
}
async function saveList(key, list){
  return storageSet(key, JSON.stringify(list), true);
}

/* ============================================================
   NAV: back links, tabs
   ============================================================ */
document.querySelectorAll('[data-back]').forEach(btn=>{
  btn.addEventListener('click', ()=> show(btn.dataset.back));
});

$('btn-go-user').addEventListener('click', ()=> show('view-user-login'));
$('btn-go-admin').addEventListener('click', ()=> show('view-admin-login'));

/* Generic tab wiring: works for any .tabs container whose buttons
   carry data-panel, scoped to panels living inside `scopeSelector`. */
function wireTabs(tabsId, scopeSelector){
  const tabsEl = document.getElementById(tabsId);
  if(!tabsEl) return;
  tabsEl.addEventListener('click', (e)=>{
    const btn = e.target.closest('.tab-btn');
    if(!btn) return;
    tabsEl.querySelectorAll('.tab-btn').forEach(b=>b.classList.remove('active'));
    btn.classList.add('active');
    document.querySelectorAll(scopeSelector + ' .panel').forEach(p=>p.classList.remove('active'));
    $(btn.dataset.panel).classList.add('active');
  });
}
wireTabs('user-tabs', '#view-dashboard');
wireTabs('p2-tabs', '#view-dashboard-p2');
wireTabs('admin-tabs', '#view-admin');

/* ============================================================
   PROJECT SELECTOR NAV
   ============================================================ */
